{
  "name": "code-arsenal",
  "version": "2.0.0",
  "description": "Browser-based programming practice with real tests, run in a sandbox.",
  "scripts": {
    "verify": "node scripts/verify-problems.js",
    "test:unit": "node --test tests/unit/",
