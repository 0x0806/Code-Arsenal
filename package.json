  },
  "homepage": "https://github.com/0x0806/Code-Arsenal#readme",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@playwright/test": "^1.65.1",
    "codemirror": "^5.65.16"
  },
